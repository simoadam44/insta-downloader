# Admin auth (set in Vercel env vars)
ADMIN_PASSWORD=change-me-in-vercel
ADMIN_JWT_SECRET=super-long-random-string-min-32-chars
# Optional: external extractor backend (legacy { items } shape OR Cobalt API schema)
EXTRACTOR_API_URL=
EXTRACTOR_API_KEY=
# Recommended (free): your own self-hosted Cobalt API instance.
#   docker run -d --name cobalt -p 9000:9000 --restart unless-stopped ghcr.io/imputnet/cobalt:latest
# Then set COBALT_API_URL to https://YOUR-INSTANCE/api/json
# (Do NOT use api.cobalt.tools — it requires keys/permission.)
COBALT_API_URL=
COBALT_API_KEY=
# Public site URL for canonical/hreflang
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
